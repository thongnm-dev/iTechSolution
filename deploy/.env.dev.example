# ── Development environment ─────────────────────────────────────
# Copy this file to .env and fill in the required values.

APP_NAME=iTechSolution
APP_KEY=              # Required. Run: docker compose -f docker-compose.dev.yml exec backend php artisan key:generate

# Ports exposed on the host
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Database
DB_PORT=5434
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret    # Change this
