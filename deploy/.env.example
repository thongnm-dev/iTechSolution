APP_PORT=80
APP_NAME=iTechSolution
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=

DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=

# Baked into the frontend JS at build time (Vite). Leave as /api since
# nginx serves the Vue app and the Laravel API from the same origin.
VITE_API_URL=/api
