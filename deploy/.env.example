APP_PORT=80
APP_NAME=iTechSolution
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY= # Required. Generate with: php artisan key:generate --show

# Database (PostgreSQL). DB_PORT is a single port used both inside Docker
# (app -> postgres:DB_PORT) and published on the host for pgAdmin/DBeaver.
# Keep DB_HOST=postgres (the compose service name) unless pointing at an
# external database.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5434
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD= # Required. Set a strong password

# Baked into the frontend JS at build time (Vite). Leave as /api since
# nginx serves the Vue app and the Laravel API from the same origin.
VITE_API_URL=/api
