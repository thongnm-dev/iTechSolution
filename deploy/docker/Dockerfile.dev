# syntax=docker/dockerfile:1

# Development image: PHP with extensions needed by the Laravel backend.
# Used with bind-mounted source code — no COPY of application files.
FROM php:8.4-cli-alpine

RUN apk add --no-cache \
        git \
        unzip \
        libpng-dev \
        libzip-dev \
        libjpeg-turbo-dev \
        freetype-dev \
        icu-dev \
        oniguruma-dev \
        postgresql-dev \
        linux-headers \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" \
        pdo_pgsql \
        mbstring \
        bcmath \
        exif \
        gd \
        zip \
        intl \
        pcntl \
    && rm -rf /var/cache/apk/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

EXPOSE 8000
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]
